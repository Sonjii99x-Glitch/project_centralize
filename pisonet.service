[Unit]
Description=PISONET Internet Cafe Management System
After=network.target
Wants=network.target

[Service]
Type=simple
User=pisonet
Group=pisonet
WorkingDirectory=/opt/pisonet
ExecStart=/opt/pisonet/venv/bin/python /opt/pisonet/server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pisonet

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/pisonet/data /opt/pisonet/backups
ProtectHome=yes
PrivateDevices=no

# GPIO access for Orange Pi
SupplementaryGroups=gpio i2c spi

[Install]
WantedBy=multi-user.target